{
  "manifest_version": 3,
  "name": "Container Corral",
  "version": "0.9.1",
  "description": "Group tabs by their Multi-Account Container into native tab groups, and open chosen sites in a chosen container.",
  "browser_specific_settings": {
    "gecko": {
      "id": "container-corral@ima-hima.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "contextualIdentities",
    "cookies",
    "storage",
    "menus",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
